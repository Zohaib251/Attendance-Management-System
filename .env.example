# ─────────────────────────────────────────────────────────────────────────────
# Attendance Management System — Environment Configuration (FastAPI / Render)
# ─────────────────────────────────────────────────────────────────────────────

# Database URL (Default falls back to sqlite:///./attendance.db if omitted)
# For Supabase / Render PostgreSQL, use:
# DATABASE_URL=postgresql://postgres.xxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:port/db

# Application Secret Key
SECRET_KEY=your-super-secret-key-here

# Environment Settings
DEBUG=True
ALLOWED_HOSTS=*
SITE_URL=http://localhost:8000
